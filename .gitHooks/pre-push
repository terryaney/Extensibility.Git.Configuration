# GitHub mirrors pushed automatically after an origin push. Each name must be a configured
# remote whose URL carries its own account (https://<account>@github.com/...) so the
# credential manager hands each push the matching GitHub identity.
MIRROR_REMOTES="gh gh-conduent"

is_mirror_remote() {
	local candidate="$1"
	local remote
	for remote in $MIRROR_REMOTES; do
		[ "$candidate" = "$remote" ] && return 0
	done
	return 1
}

# Only mirror when the push targets the primary remote by name (not a URL, not a mirror itself)
if ! is_mirror_remote "$1" && [ "$1" != "conduent" ] && [[ "$2" != :* ]]; then
	MIRRORED=0
	for mirror in $MIRROR_REMOTES; do
		if git remote | grep -q "^${mirror}$"; then
			MIRRORED=1
			echo "Pushing to Github ($mirror)..."
			echo ""
			if DOC_SYNC_SKIP=1 git push "$mirror"; then
				echo ""
				echo "Github push complete ($mirror)."
			else
				echo ""
				echo "WARNING: push to $mirror failed — continuing with $1."
			fi
			echo ""
		fi
	done

	if [ "$MIRRORED" = "1" ]; then
		echo "Pushing to $1..."
		echo ""
	fi
fi

# Continue with the original push
exit 0