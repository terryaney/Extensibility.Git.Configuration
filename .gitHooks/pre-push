#!/bin/bash

# Read push refs from stdin once — stdin can only be consumed once so this must happen
# before any case blocks that previously had their own read loops.
CURRENT_BRANCH=""
CURRENT_COMMIT=""
PUSHED_MAIN_SHA=""
while read local_ref local_sha remote_ref remote_sha
do
	if [[ $local_ref = refs/heads/main ]]; then
		CURRENT_BRANCH="main"
		PUSHED_MAIN_SHA="$local_sha"
		CURRENT_COMMIT=$(echo "$local_sha" | cut -c1-7)
	fi
done

# Helper: copy one blob from the pushed main commit into the documentation repository and stage it.
# Returns 0 only when the destination was actually updated.
# Usage: stage_doc_file <src_file> <dest_name> <dest_repo_path> <repo_root>
stage_doc_file() {
	local SRC_FILE="$1"
	local DEST_NAME="$2"
	local DEST_REPO_PATH="$3"
	local REPO_ROOT="$4"

	local tmp_file="$REPO_ROOT/.git/doc-sync-$CURRENT_COMMIT-$(basename "$SRC_FILE")"

	if ! git show "$PUSHED_MAIN_SHA:$SRC_FILE" > "$tmp_file" 2>/dev/null; then
		rm -f "$tmp_file"
		return 1
	fi

	if ! git -C "$DEST_REPO_PATH" diff --quiet -- "$DEST_NAME" 2>/dev/null || \
	   ! git -C "$DEST_REPO_PATH" diff --cached --quiet -- "$DEST_NAME" 2>/dev/null; then
		echo "Camelot Documentation Sync skipped $DEST_NAME — destination has unstaged/uncommitted changes."
		rm -f "$tmp_file"
		return 1
	fi

	if diff -q "$tmp_file" "$DEST_REPO_PATH/$DEST_NAME" > /dev/null 2>&1; then
		echo "Camelot Documentation Sync skipped $DEST_NAME — already up to date."
		rm -f "$tmp_file"
		return 1
	fi

	mkdir -p "$(dirname "$DEST_REPO_PATH/$DEST_NAME")"
	cp "$tmp_file" "$DEST_REPO_PATH/$DEST_NAME"
	git -C "$DEST_REPO_PATH" add "$DEST_NAME"
	rm -f "$tmp_file"
	return 0
}

# Helper: sync all files matching a pattern from the pushed main commit to a documentation repository as one commit.
# Source folder structure is flattened — every match lands directly in <dest_subfolder>.
# Usage: sync_doc_files <src_dir> <file_pattern> <dest_subfolder> <dest_repo_path> <dest_branch> <repo_label>
sync_doc_files() {
	local SRC_DIR="$1"
	local FILE_PATTERN="$2"
	local DEST_SUBFOLDER="$3"
	local DEST_REPO_PATH="$4"
	local DEST_BRANCH="$5"
	local REPO_LABEL="$6"

	[ "$CURRENT_BRANCH" = "main" ] || return

	local REPO_ROOT
	REPO_ROOT="$(git rev-parse --show-toplevel)"
	local STAGED=""

	local SAVED_GIT_DIR="${GIT_DIR:-}"
	local SAVED_GIT_WORK_TREE="${GIT_WORK_TREE:-}"
	unset GIT_DIR GIT_WORK_TREE

	while IFS= read -r src_file; do
		if stage_doc_file "$src_file" "$DEST_SUBFOLDER/$(basename "$src_file")" "$DEST_REPO_PATH" "$REPO_ROOT"; then
			STAGED="$STAGED $DEST_SUBFOLDER/$(basename "$src_file")"
		fi
	done < <(git ls-tree --name-only "$PUSHED_MAIN_SHA" "$SRC_DIR" 2>/dev/null | grep "$FILE_PATTERN")

	if [ -n "$STAGED" ]; then
		git -C "$DEST_REPO_PATH" commit -m "Automatically updated $DEST_SUBFOLDER docs from main:$REPO_LABEL, commit $CURRENT_COMMIT"
		git -C "$DEST_REPO_PATH" push origin "$DEST_BRANCH"
	fi

	[ -n "$SAVED_GIT_DIR" ] && export GIT_DIR="$SAVED_GIT_DIR"
	[ -n "$SAVED_GIT_WORK_TREE" ] && export GIT_WORK_TREE="$SAVED_GIT_WORK_TREE"
}

# Helper: sync files and/or folders (recursive) from the pushed main commit, preserving the source
# folder structure underneath <dest_subfolder>, as one commit.
# Usage: sync_doc_paths <dest_subfolder> <dest_repo_path> <dest_branch> <repo_label> <src_path>...
sync_doc_paths() {
	local DEST_SUBFOLDER="$1"; shift
	local DEST_REPO_PATH="$1"; shift
	local DEST_BRANCH="$1"; shift
	local REPO_LABEL="$1"; shift

	[ "$CURRENT_BRANCH" = "main" ] || return

	local REPO_ROOT
	REPO_ROOT="$(git rev-parse --show-toplevel)"
	local STAGED=""

	local SAVED_GIT_DIR="${GIT_DIR:-}"
	local SAVED_GIT_WORK_TREE="${GIT_WORK_TREE:-}"
	unset GIT_DIR GIT_WORK_TREE

	local src_path src_file
	for src_path in "$@"; do
		while IFS= read -r src_file; do
			if stage_doc_file "$src_file" "$DEST_SUBFOLDER/$src_file" "$DEST_REPO_PATH" "$REPO_ROOT"; then
				STAGED="$STAGED $DEST_SUBFOLDER/$src_file"
			fi
		done < <(git ls-tree -r --name-only "$PUSHED_MAIN_SHA" -- "$src_path" 2>/dev/null)
	done

	if [ -n "$STAGED" ]; then
		git -C "$DEST_REPO_PATH" commit -m "Automatically updated $DEST_SUBFOLDER docs from main:$REPO_LABEL, commit $CURRENT_COMMIT"
		git -C "$DEST_REPO_PATH" push origin "$DEST_BRANCH"
	fi

	[ -n "$SAVED_GIT_DIR" ] && export GIT_DIR="$SAVED_GIT_DIR"
	[ -n "$SAVED_GIT_WORK_TREE" ] && export GIT_WORK_TREE="$SAVED_GIT_WORK_TREE"
}

